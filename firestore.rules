// Order Verification rules. Reference copy only.
//
// These live in the smart-scheduler-1915 Firebase project, at the bottom of the rules
// (Firestore Database > Rules), after the Smart Scheduler and Store Visit rules.
// They were published there on 2026-09-29. Do NOT paste this file over the whole
// rules editor: that would wipe the Smart Scheduler and Store Visit rules.
// If you ever need to re-add them, paste the block below just above the last two closing braces.
// It relies on signedIn(), email() and isOwner(), which the Smart Scheduler rules define.
// signedIn() there requires a confirmed email (email link, or email + password after the confirmation email).

    // ───────── Order Verification app (everything below only touches the verifications collection) ─────────
    function ovCompany() {
      return signedIn() && email().matches('.*@1915south[.]com');
    }
    match /verifications/{id} {
      allow create: if ovCompany()
        && request.resource.data.submittedBy == request.auth.uid
        && request.resource.data.submittedByEmail == email()
        && request.resource.data.submittedAt == request.time;
      allow read: if ovCompany();   // any verified 1915 South leader can look up any store
      allow update, delete: if isOwner();
    }
    // The full frozen record for each verification (same id), loaded when someone taps Open.
    match /verificationRecords/{id} {
      allow create: if ovCompany()
        && request.resource.data.submittedBy == request.auth.uid
        && request.resource.data.submittedAt == request.time
        && request.resource.data.htmlRecord.size() < 900000;
      allow read: if ovCompany();   // any verified 1915 South leader can look up any store
      allow update, delete: if isOwner();
    }
